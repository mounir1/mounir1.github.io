rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      // Replace with your actual Firebase Auth UID for production
      // You can find it in Firebase Console → Authentication → Users
      return request.auth != null && (
        request.auth.token.email == "mounir.webdev@gmail.com" ||
        request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_UID"
      );
    }

    function isValidString(data, field, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidContactMetadata(data) {
      return !("metadata" in data) || (
        data.metadata is map &&
        data.metadata.keys().hasOnly(["userAgent", "referrer", "page"]) &&
        isValidString(data.metadata, "userAgent", 500) &&
        isValidString(data.metadata, "referrer", 2048) &&
        isValidString(data.metadata, "page", 200)
      );
    }

    function isValidContactMessage() {
      let data = request.resource.data;
      return data.keys().hasAll([
          "name", "email", "subject", "message", "type", "status", "createdAt"
        ]) &&
        data.keys().hasOnly([
          "name", "email", "subject", "message", "phone", "company", "budget",
          "type", "status", "metadata", "createdAt"
        ]) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 200 &&
        data.email.matches("^[^@ ]+@[^@ ]+[.][^@ ]+$") &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        data.type in ["general", "project", "hire", "collaboration", "other"] &&
        data.status == "unread" &&
        data.createdAt is int &&
        isValidString(data, "phone", 40) &&
        isValidString(data, "company", 120) &&
        isValidString(data, "budget", 80) &&
        isValidContactMetadata(data);
    }

    // ─── PUBLIC READ collections (portfolio content) ────────────────────────

    // Projects — public read, owner write
    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Experience — public read (filtered by disabled=false on client)
    match /experiences/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Skills — public read
    match /skills/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Testimonials — public read (filtered by disabled=false on client)
    match /testimonials/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Links — public read (portfolio footer links)
    match /links/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Upcoming projects — public read
    match /upcoming_projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Site settings — public read (needed for hero stats, feature flags etc.)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ─── RESTRICTED collections ─────────────────────────────────────────────

    // Contact messages — public CREATE only (form submissions), owner read/update
    match /contact_messages/{docId} {
      // Shape and size checks limit malformed writes; they are not rate limits.
      allow create: if isValidContactMessage();
      // Only owner can read messages and update status
      allow read, update, delete: if isOwner();
    }

    // ─── Block everything else by default ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

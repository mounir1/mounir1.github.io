# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files - NEVER commit these
.env
.env.local
.env.*.local
.env.development.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build artifacts
*.msi
*.exe
*.dmg

# Root-level compiled assets (built by Vite into dist/)
/assets/

# Lockfiles from other package managers
bun.lockb

# Misc junk
deploy.ps1
image.jpeg
public/image.jpeg
public/node-v24.6.0-x64.msi
public/*.msi
public/*.exe
public/*.dmg

# Firebase
.firebase/
.firebaserc.local

# Vite cache
.vite/

# Lossless image masters belong in asset-sources/ (committed) — never in
# public/, because dist copies public/ verbatim and GitHub Pages serves dist, so
# a master parked here ships ~17x the bytes of the asset it produces on every
# deploy. These lines stay as a guard against exactly that; scripts/optimize-images.mjs
# still reads public/profile-source.png for backward compatibility.
public/*-source.png
public/*-source.webp
public/*-source.jpg

# TypeScript build info (incremental builds via tsc --build)
*.tsbuildinfo

# OS files
Thumbs.db

# Wrangler local dev state (miniflare cache/db, never commit)
.wrangler/

# Playwright MCP test artifacts
.playwright-mcp/
